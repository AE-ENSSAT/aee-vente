# fastlane/Fastfile — iOS signing + packaging for CI.
#
#   develop → `dev`  : development-signed IPA → Firebase App Distribution
#   main    → `prod` : ONE archive, TWO exports — App Store IPA → TestFlight, ad-hoc IPA →
#                      Firebase (App Distribution cannot install an App Store-signed IPA).
#
# Why fastlane here: a device-locked profile does NOT auto-include devices registered after
# it was created. Both lanes force-regenerate their profiles at build time via an App Store
# Connect API key, so every currently-registered device — including ones Firebase adds when
# a tester accepts an invite — is baked into the next build. Adding a tester needs a re-run,
# nothing else.
#
# `develop` uses DEVELOPMENT signing because this account's Tap to Pay entitlement was
# development-only when that lane was written; `main` signs with Apple Distribution.
#
# The certificate (+ private key) is imported into the keychain by the CI workflow
# (apple-actions/import-codesign-certs) before this runs — a Development cert in the
# `develop` environment, a Distribution one in `production`.
#
# Env expected: IOS_BUNDLE_ID, IOS_TEAM_ID, ASC_KEY_ID, ASC_ISSUER_ID, ASC_API_KEY_P8
# (base64 of the .p8), RUNNER_TEMP, GITHUB_OUTPUT.

default_platform(:ios)

# Anchored to an absolute path — fastlane's working directory isn't guaranteed to be the
# repo root, and ios/ only exists after prebuild.
def expo_workspace
	root = ENV['GITHUB_WORKSPACE'] || Dir.pwd
	workspace = Dir[File.join(root, 'ios', '*.xcworkspace')].first
	UI.user_error!("No ios/*.xcworkspace under #{root} — did `expo prebuild` run?") unless workspace
	workspace
end

def asc_api_key
	app_store_connect_api_key(
		key_id: ENV.fetch('ASC_KEY_ID'),
		issuer_id: ENV.fetch('ASC_ISSUER_ID'),
		key_content: ENV.fetch('ASC_API_KEY_P8'),
		is_key_content_base64: true,
	)
end

# The Expo project defaults to automatic signing; CI has no Apple ID to drive it.
def manual_signing_xcargs(profile_name, identity)
	[
		'CODE_SIGN_STYLE=Manual',
		"CODE_SIGN_IDENTITY=\"#{identity}\"",
		"DEVELOPMENT_TEAM=#{ENV.fetch('IOS_TEAM_ID')}",
		"PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
	].join(' ')
end

def emit_github_output(key, value)
	out = ENV['GITHUB_OUTPUT']
	File.open(out, 'a') { |f| f.puts("#{key}=#{value}") } if out
end

platform :ios do
	desc 'develop: development-signed IPA for Firebase App Distribution'
	lane :dev do
		workspace = expo_workspace
		bundle_id = ENV.fetch('IOS_BUNDLE_ID')
		api_key = asc_api_key

		# force: true regenerates the profile so newly-registered devices are included.
		sigh(
			development: true,
			force: true,
			app_identifier: bundle_id,
			team_id: ENV['IOS_TEAM_ID'],
			api_key: api_key,
		)
		profile_name = lane_context[SharedValues::SIGH_NAME]

		build_app(
			workspace: workspace,
			scheme: File.basename(workspace, '.xcworkspace'),
			configuration: 'Release',
			export_method: 'development',
			xcargs: manual_signing_xcargs(profile_name, 'Apple Development'),
			export_options: {
				signingStyle: 'manual',
				provisioningProfiles: { bundle_id => profile_name },
			},
			output_directory: ENV.fetch('RUNNER_TEMP'),
			output_name: 'aee-vente.ipa',
		)

		ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
		emit_github_output('ipa_path', ipa)
		UI.success("Built #{ipa}")
	end

	desc 'main: App Store IPA → TestFlight, plus an ad-hoc IPA for Firebase'
	lane :prod do
		workspace = expo_workspace
		bundle_id = ENV.fetch('IOS_BUNDLE_ID')
		api_key = asc_api_key
		temp = ENV.fetch('RUNNER_TEMP')

		# Two profiles off the SAME Apple Distribution certificate. force: true on both —
		# ad-hoc needs it for the device list, App Store so a capability change (e.g. the
		# Tap to Pay entitlement) is picked up instead of reusing a stale profile.
		sigh(force: true, app_identifier: bundle_id, team_id: ENV['IOS_TEAM_ID'], api_key: api_key)
		app_store_profile = lane_context[SharedValues::SIGH_NAME]

		sigh(adhoc: true, force: true, app_identifier: bundle_id, team_id: ENV['IOS_TEAM_ID'], api_key: api_key)
		adhoc_profile = lane_context[SharedValues::SIGH_NAME]

		archive_path = File.join(temp, 'aee-vente.xcarchive')

		build_app(
			workspace: workspace,
			scheme: File.basename(workspace, '.xcworkspace'),
			configuration: 'Release',
			skip_package_ipa: true,
			archive_path: archive_path,
			xcargs: manual_signing_xcargs(app_store_profile, 'Apple Distribution'),
		)

		# Export twice from the one archive: xcodebuild re-signs at export time, so the
		# ad-hoc build is the same compiled binary rather than a second ~20-minute build.
		app_store_ipa = build_app(
			skip_build_archive: true,
			archive_path: archive_path,
			export_method: 'app-store',
			export_team_id: ENV.fetch('IOS_TEAM_ID'),
			export_options: {
				signingStyle: 'manual',
				provisioningProfiles: { bundle_id => app_store_profile },
			},
			output_directory: temp,
			output_name: 'aee-vente-appstore.ipa',
		)

		adhoc_ipa = build_app(
			skip_build_archive: true,
			archive_path: archive_path,
			export_method: 'ad-hoc',
			export_team_id: ENV.fetch('IOS_TEAM_ID'),
			export_options: {
				signingStyle: 'manual',
				provisioningProfiles: { bundle_id => adhoc_profile },
			},
			output_directory: temp,
			output_name: 'aee-vente-adhoc.ipa',
		)

		upload_to_testflight(
			api_key: api_key,
			ipa: app_store_ipa,
			app_identifier: bundle_id,
			# Apple's processing takes minutes and tells us nothing a failed upload wouldn't;
			# the build appears in TestFlight on its own once done.
			skip_waiting_for_build_processing: true,
		)

		# The workflow's Firebase step is branch-agnostic, so `ipa_path` always means "the
		# IPA App Distribution can install" — ad-hoc here, development on develop.
		emit_github_output('ipa_path', adhoc_ipa)
		UI.success("TestFlight: #{app_store_ipa} — Firebase: #{adhoc_ipa}")
	end
end

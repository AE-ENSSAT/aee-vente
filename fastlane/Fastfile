# fastlane/Fastfile — iOS signing + packaging for CI (the develop → Firebase path).
#
# Why fastlane here: an ad-hoc build only runs on devices listed in its provisioning
# profile, and a profile does NOT auto-include devices added after it was created. The
# `adhoc` lane force-regenerates the profile at build time via an App Store Connect API
# key, so every currently-registered device — including ones Firebase auto-registers when
# a tester accepts an invite — is baked into the next build. Net: adding a tester needs no
# manual profile juggling, just a re-run.
#
# The distribution certificate (+ private key) is imported into the keychain by the CI
# workflow (apple-actions/import-codesign-certs) before this runs.
#
# Env expected: IOS_BUNDLE_ID, IOS_TEAM_ID, ASC_KEY_ID, ASC_ISSUER_ID, ASC_API_KEY_P8
# (base64 of the .p8), RUNNER_TEMP, GITHUB_OUTPUT.

default_platform(:ios)

WORKSPACE = Dir['ios/*.xcworkspace'].first
SCHEME = WORKSPACE && File.basename(WORKSPACE, '.xcworkspace')

platform :ios do
	desc 'Build an ad-hoc IPA with a freshly regenerated provisioning profile'
	lane :adhoc do
		UI.user_error!('No ios/*.xcworkspace found — run `expo prebuild` first.') unless WORKSPACE

		bundle_id = ENV.fetch('IOS_BUNDLE_ID')

		api_key = app_store_connect_api_key(
			key_id: ENV.fetch('ASC_KEY_ID'),
			issuer_id: ENV.fetch('ASC_ISSUER_ID'),
			key_content: ENV.fetch('ASC_API_KEY_P8'),
			is_key_content_base64: true,
		)

		# force: true regenerates the profile so newly-registered devices are included.
		sigh(
			adhoc: true,
			force: true,
			app_identifier: bundle_id,
			team_id: ENV['IOS_TEAM_ID'],
			api_key: api_key,
		)
		profile_name = lane_context[SharedValues::SIGH_NAME]

		build_app(
			workspace: WORKSPACE,
			scheme: SCHEME,
			configuration: 'Release',
			export_method: 'ad-hoc',
			# Force manual signing at archive time (the Expo project defaults to automatic).
			xcargs: [
				'CODE_SIGN_STYLE=Manual',
				"DEVELOPMENT_TEAM=#{ENV.fetch('IOS_TEAM_ID')}",
				"PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\"",
			].join(' '),
			export_options: {
				signingStyle: 'manual',
				provisioningProfiles: { bundle_id => profile_name },
			},
			output_directory: ENV.fetch('RUNNER_TEMP'),
			output_name: 'aee-vente.ipa',
		)

		ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
		github_output = ENV['GITHUB_OUTPUT']
		File.open(github_output, 'a') { |f| f.puts("ipa_path=#{ipa}") } if github_output
		UI.success("Built #{ipa}")
	end
end

# --- AEE Manager API ---
# Base URL of the backend (no trailing slash). The typed client in src/api is built
# against its OpenAPI document (src/api/spec.json).
API_BASE_URL=https://api.aee-manager.bde-enssat.fr

# --- Keycloak (issues the bearer token the API validates) ---
# The API has no login endpoint of its own: it only verifies Keycloak JWTs.
KEYCLOAK_URL=https://auth.aee-manager.bde-enssat.fr
KEYCLOAK_REALM=app
# Public client used by the app. Sign-in is SSO (authorization code + PKCE), so this
# client needs "Standard flow" enabled and `aeevente://auth` registered both as a Valid
# redirect URI and as a Valid post logout redirect URI. No client secret: PKCE covers it.
KEYCLOAK_CLIENT_ID=web

# --- Runtime SumUp keys (from your SumUp Dashboard) ---
# Affiliate key (sup_afk_...) — used by the card-reader (merchant) SDK. It identifies the
# app, not a merchant, so bundling it is fine.
# NOTE: there is no SUMUP_ACCESS_TOKEN here on purpose. The login token is the
# association's own secret key (sup_sk_...) and is served per tenant by the API
# (GET /payment-method-config → apiKey), so it is never shipped in the app.
SUMUP_AFFILIATE_KEY=sup_afk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Android: Maven credentials for the SumUp Tap to Pay private repo ---
# Request these from SumUp's integration team (integration@sumup.com).
# Read at Gradle time by the withSumUp config plugin (env vars or gradle.properties).
SUMUP_MAVEN_USER=your_username_provided_by_sumup
SUMUP_MAVEN_PASSWORD=your_password_provided_by_sumup

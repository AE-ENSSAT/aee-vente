# Copy this file to ".env" and fill in your real values. ".env" is gitignored.

# --- Runtime SumUp keys (from your SumUp Dashboard) ---
# Affiliate key (sup_afk_...) — used by the card-reader (merchant) SDK.
SUMUP_AFFILIATE_KEY=sup_afk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret API key (sup_sk_...) — used as the login access token.
SUMUP_ACCESS_TOKEN=sup_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Android: Maven credentials for the SumUp Tap to Pay private repo ---
# Request these from SumUp's integration team (integration@sumup.com).
# Read at Gradle time by the withSumUp config plugin (env vars or gradle.properties).
SUMUP_MAVEN_USER=your_username_provided_by_sumup
SUMUP_MAVEN_PASSWORD=your_password_provided_by_sumup
